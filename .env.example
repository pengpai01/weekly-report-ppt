# weekly-report-ppt — copy to `.env` in this project root (E:\grok_bot).
# Do not commit `.env`. Do not export these as system-wide environment variables.

# Independent process. Default 5174 to avoid clashing with other local apps.
HOST=0.0.0.0
PORT=5174
SERVICE_NAME=weekly-report-ppt

# Local ancillary files only (logs). Must stay under the project directory.
# Windows deploy: E:\grok_bot\data
DATA_DIR=data

# Remote MySQL (database grok_bot). This app only creates/uses wr_* tables.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Yunxiao (云效) read-only import. Never commit the PAT.
# Official OpenAPI (devops/2021-06-25 ListWorkitems):
#   GET https://openapi-rdc.aliyuncs.com/organization/{orgId}/listWorkitems
# Auth: Authorization: Bearer ${YUNXIAO_PAT}
# Example org id (docs only, do not treat as a secret): 62bcfcb73e81781f3ad1d7d7
YUNXIAO_ORG_ID=
YUNXIAO_PAT=
# Optional. Default: DNK-设备软件
YUNXIAO_PROJECT_NAME=
# Optional. DNK-设备软件 (CFRK) spaceIdentifier. Default: 6230f5b04297236a20e79654d4
YUNXIAO_SPACE_ID=
